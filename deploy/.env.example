# Copy this file to deploy/.env and fill in the value.
# `.env` is git-ignored.
#
# CF_TUNNEL_TOKEN
#   Obtained at https://one.dash.cloudflare.com >
#     Zero Trust > Networks > Tunnels > Create a tunnel >
#     Cloudflared > "Install and run a connector" step,
#     copy the long string after "--token".
CF_TUNNEL_TOKEN=
